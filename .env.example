# Copy to `.env` for non-sensitive runtime options only.
# Never commit `.env` to git.
#
# Sensitive values (CONTRACT_ADDRESS, ETH_PRIVATE_KEY, FLASK_SECRET_KEY,
# MIDDLEWARE_SERVICE_TOKEN) must be stored in the OS keychain only.
#
# Middleware DB + tunables: prefer keychain (same as above).
#   python3 scripts/manage_secrets.py set MIDDLEWARE_DB_URL
#   python3 scripts/manage_secrets.py show MIDDLEWARE_DB_URL
# .env entries below are optional fallbacks for non-sensitive settings.

# Layer 2 (middleware) — customer_app uses mTLS via Caddy (mw.local)
MIDDLEWARE_URL=https://mw.local
# After: ./scripts/gen_kiosk_client_cert.sh && Caddy mw.local client_auth
# mTLS rotation (local dev, mkcert CA — same paths, mTLS stays on):
# MTLS_RENEW_BEFORE_DAYS=30
# MTLS_CERT_VALIDITY_DAYS=90
# ./scripts/mtls/rotate_mtls_certs.sh
# Admin → middleware (mTLS + X-Service-Token; after gen_admin_client_cert.sh):
# MIDDLEWARE_DIRECT_URL=https://mw.local

# Client cert allow-list on mw.local (middleware; default enforce 403 on unknown serial):
# CLIENT_CERT_ENFORCE_ALLOWLIST=1
# CLIENT_CERT_ALLOWED_SERIALS=   # optional comma-separated override
# CLIENT_CERT_MONITOR_INTERVAL_SECONDS=300

# Layer 3 (Spring Boot Core Banking) — middleware uses mTLS via Caddy (api.local)
CORE_BANKING_URL=https://api.local
# After: ./scripts/gen_mtls_client_cert.sh  (creates ~/atm-tls/middleware-client.pem)
# Admin app still uses direct HTTP: CORE_BANKING_URL=http://127.0.0.1:8080 in admin only

# Middleware Postgres — prefer keychain; TLS auto-enabled when ~/atm-tls/postgres/ca.pem exists:
#   ./scripts/gen_postgres_server_cert.sh
#   docker compose up -d   # in core-banking-system
# MIDDLEWARE_DB_URL=postgresql+psycopg://mwuser:mwpass@localhost:5433/mwuser

# Lockout testing (restart middleware after change):
# LOCKOUT_FAST_TEST=1              # ~6s / ~9s timed locks instead of 15/30 min
# LOCKOUT_MINUTES=15,30            # or set tiers manually (minutes, decimals OK)

# Sepolia RPC endpoints (middleware writes the canonical hash here)
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_RPC_FALLBACK_URLS=https://sepolia.drpc.org,https://1rpc.io/sepolia

# Reconciliation worker tunables (all optional; defaults are sane)
WORKER_RETRY_INTERVAL_SECONDS=30
WORKER_CONFIRM_INTERVAL_SECONDS=60
WORKER_TAMPER_INTERVAL_SECONDS=300
WORKER_TAMPER_LOOKBACK_HOURS=24
WORKER_MAX_SUBMIT_ATTEMPTS=8

# Customer UI idle session (prefer keychain; optional .env fallback):
# ATM_IDLE_PROMPT_SECONDS=120      # show "another transaction?" after 2 min idle
# ATM_PROMPT_TIMEOUT_SECONDS=60      # auto sign-out if no answer within 60s
# ATM_SESSION_TTL_SECONDS=900        # Flask UI session cap (15 min)
# SESSION_TTL_SECONDS=900            # middleware session_state idle cap (15 min)

# Middleware DB retention (optional .env fallback; prefer keychain)
# TRANSACTION_LOG_RETENTION_DAYS=90   # delete audit rows older than 90 days (0 = keep forever)
# RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# Flask bind (Fix 1: localhost only — use Caddy in the browser, not LAN :5001)
# BIND_HOST=127.0.0.1
# PORT=5001   # customer_app default; must match Caddy atm.local → :5001
# Open customer UI at https://atm.local (see scripts/caddy/install_caddyfile.sh)
