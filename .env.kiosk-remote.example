# Raspberry Pi kiosk — middleware + Core Banking run on another machine (laptop/server).
# Copy to .env on the Pi. Get the correct LAPTOP IP with:
#   scripts/print_pi_kiosk_env.sh   (run on the laptop while run_demo.sh is up)
#
# IMPORTANT: MIDDLEWARE_URL must be the SERVER (laptop) IP, NOT the Pi's IP.

MIDDLEWARE_URL=http://192.168.1.100:8000
MTLS_DISABLE=1

BIND_HOST=0.0.0.0
PORT=5001

FINGERPRINT_PORT=/dev/ttyUSB0
FINGERPRINT_BAUD=9600
# FINGERPRINT_SIMULATE=1
